function fixedHeader() {
    var logoactive = 'http://voltechpratama.com/wp-content/themes/cakramerlindo/images/logotop.png';
    var logowhite = 'http://voltechpratama.com/wp-content/themes/cakramerlindo/images/logotop.png';
    var setHeader = function() {
        if (jQuery(window).scrollTop() > 10) {
            jQuery('#top-nav').addClass('fixed-header');
            jQuery('#logo').attr('src', logoactive);
        } else {
            jQuery('#top-nav').removeClass('fixed-header')
            jQuery('#logo').attr('src', logowhite);
        }

            
        if  (jQuery(window).width() <= 762) {
            jQuery('#logo').attr('src', logoactive);
        }
    }
    try {
        setHeader();
        jQuery(window).scroll(setHeader).resize(setHeader);
    } catch (error) {
        console.log(error);
    }
}

</script>

