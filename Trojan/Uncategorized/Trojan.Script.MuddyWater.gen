Attribute VB_Name = "IFUO3HT8U3OGIERUGHEOWRIUG"
Function func(ByVal bbbb)
    Output = ""
    For I = 1 To Len(bbbb)
        Value = Value * 52 + (Asc(Mid(bbbb, I, 1)) - 40)
        If I Mod 3 = 0 Then
            While Value > 0
                v = Value Mod 256
                If v > 0 Then
                    Output = Chr(v) + Output
                End If
                Value = Value \ 256
            Wend
            Value = 0
        End If
    Next
    func = Output
End Function

