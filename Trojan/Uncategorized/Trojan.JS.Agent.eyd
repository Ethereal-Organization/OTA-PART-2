// Check if the script is running with administrative privileges
function checkAdmin() {
    exec('net session >nul 2>&1', (error, stdout, stderr) => {
        if (error) {
            console.log('Requesting administrative privileges...');
            exec('powershell -Command "Start-Process \'' + process.argv[0] + '\' -Verb RunAs"', (error) => {
                if (error) {
                    console.error('Failed to request administrative privileges:', error);
                } else {
                    process.exit(0);
                }
            });
        }
    });
}

checkAdmin();

