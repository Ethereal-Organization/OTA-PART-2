
# RC4 Encrypted PowerShell Script with Advanced Array Operations
# Complex array-based RC4 decryption implementation

# Encrypted data and RC4 key arrays
$cipherTextB64 = ''
$rc4KeyEncoded = 'aWkNYit7rIpTECfAOjgei8/ibtEtEjdXRkHb9mw7fuI='

# Base64 decoding function using arrays
$base64DecoderFunc = {
    param([string]$encodedInput)
    [System.Convert]::FromBase64String($encodedInput)
}

# Convert Base64 to byte arrays
$payloadBytes = & $base64DecoderFunc $cipherTextB64
$cryptoKey = & $base64DecoderFunc $rc4KeyEncoded

# RC4 S-box initialization function
$sBoxArray = {
    param([byte[]]$rc4Key)
    
    $sBoxArray = new-object byte[] 256
    $indexArray = new-object int[] 256
    
    # Initialize S-box
    for ($i = 0; $i -lt 256; $i++) {
        $sBoxArray[$i] = [byte]$i
        $indexArray[$i] = $i
    }
    
    $jValue = 0
    foreach ($currentI in $indexArray) {
        $jValue = ($jValue + $sBoxArray[$currentI] + $rc4Key[$currentI % $rc4Key.Length]) -band 255
        
        # Swap values
        $tempByte = $sBoxArray[$currentI]
        $sBoxArray[$currentI] = $sBoxArray[$jValue]
        $sBoxArray[$jValue] = $tempByte
    }
    
    return $sBoxArray
}

# Array-based RC4 decryption function
$rc4Processor = {
    param(
        [byte[]]$inputBuffer,
        [byte[]]$rc4Key
    )
    
    # Initialize RC4 S-box
    $rc4SBox = & $sBoxArray -rc4Key $rc4Key
    
    $outputResult = new-object byte[] $inputBuffer.Length
    $positionMap = new-object int[] $inputBuffer.Length
    
    # Initialize position mapping array
    for ($counter = 0; $counter -lt $inputBuffer.Length; $counter++) {
        $positionMap[$counter] = $counter
    }
    
    $rc4I = 0
    $rc4J = 0
    
    # Process each element using RC4 algorithm
    foreach ($currentPos in $positionMap) {
        $rc4I = ($rc4I + 1) -band 255
        $rc4J = ($rc4J + $rc4SBox[$rc4I]) -band 255
        
        # Swap values in S-box
        $swapTemp = $rc4SBox[$rc4I]
        $rc4SBox[$rc4I] = $rc4SBox[$rc4J]
        $rc4SBox[$rc4J] = $swapTemp
        
        # Generate keystream byte
        $keystreamByte = $rc4SBox[($rc4SBox[$rc4I] + $rc4SBox[$rc4J]) -band 255]
        
        # XOR with encrypted data
        $outputResult[$currentPos] = $inputBuffer[$currentPos] -bxor $keystreamByte
    }
    
    return $outputResult
}

# Main decryption wrapper with array processing
$mainDecoder = {
    param(
        [byte[]]$payloadBytes,
        [byte[]]$cryptoKey
    )
    
    try {
        # Use array-based RC4 decryption
        $outputResult = & $rc4Processor -inputBuffer $payloadBytes -rc4Key $cryptoKey
        
        $decodedText = [System.Text.Encoding]::UTF8.GetString($outputResult)
        return $decodedText
    }
    catch {
        $failureMessage = $_.Exception.Message
        Write-Error $failureMessage
        return $null
    }
}

# Execute decryption using arrays
$finalScript = & $mainDecoder -payloadBytes $payloadBytes -cryptoKey $cryptoKey

if ($finalScript -ne $null) {
    # Array of execution methods
    $executionHandlers = @(
        { param(${c}) Invoke-Expression -Command $c },
        { param(${c}) iex $c },
        { param(${c}) & $c }
    )
    
    # Use first execution method
    & $executionHandlers[0] $finalScript
} else {
    $failureNotifications = @(
        "RC4 Decryption failed!",
        "RC4 decryption unsuccessful!",
        "Failed to decrypt script!"
    )
    Write-Host $failureNotifications[0]
}
