Public Sub WidthA(Dbbb As String, bbbJ As String, Optional system_ofADown_Sexote As String)

  Dim bbb As Integer
bbb = FreeFile
  Dim Gbbb() As Byte
  
  Open Dbbb For Binary As #bbb
  ReDim Gbbb(0 To LOF(bbb) - 1)
  Get #bbb, , Gbbb()
  Close #bbb
  Call Subfunc(Gbbb(), system_ofADown_Sexote)
  bbb = FreeFile
  Open bbbJ For Binary As #bbb
  Put #bbb, , Gbbb()
  Close #bbb

End Sub


