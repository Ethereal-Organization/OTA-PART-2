font-size:12px;
font-family:Tahoma,Georgia,Century gothic, Arial, sans-serif;
}
.sidebar1 h2 {
line-height:30px;
font-size:14px;
color:#fff;
margin:5px 0 0px 0 ;
padding:0px 0 0 5px;
background:#948e6f;
font-weight:bold;
font-family:Georgia,Century gothic, Arial, sans-serif;
text-transform:uppercase;
border:1px solid #E7E0BB;
}
.sidebar1 ul {
list-style-type: none;
margin: 0 ;
padding: 0;
}
.sidebar1 ul ul  {
list-style-type: none;
