Function Stream_BinaryToString(Binary)
  Const aTopisojn = 2
  Const adTypeBinary = 1
  Dim rxRADDDDFFFFFFHHHHHHJJJJJJJMMM 'As New Stream
  Set rxRADDDDFFFFFFHHHHHHJJJJJJJMMM = createobject("Adodb.Stream")
  rxRADDDDFFFFFFHHHHHHJJJJJJJMMM.Type = adTypeBinary
  rxRADDDDFFFFFFHHHHHHJJJJJJJMMM.Open
  rxRADDDDFFFFFFHHHHHHJJJJJJJMMM.Write Binary
  rxRADDDDFFFFFFHHHHHHJJJJJJJMMM.Position = 0
  rxRADDDDFFFFFFHHHHHHJJJJJJJMMM.Type = aTopisojn
  rxRADDDDFFFFFFHHHHHHJJJJJJJMMM.CharSet = "us-ascii"
  Stream_BinaryToString = rxRADDDDFFFFFFHHHHHHJJJJJJJMMM.ReadText
  Set rxRADDDDFFFFFFHHHHHHJJJJJJJMMM = Nothing
End Function