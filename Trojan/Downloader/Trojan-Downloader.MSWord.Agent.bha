Function GetNumberOfLines(strfile)
Dim oFso, f, i
Set oFso = CreateObject("Scripting.FileSystemObject")
Set f = oFso.OpenTextFile(strfile, 1)
i = 0

Do
f.ReadLine
i = i + 1
Loop While Not f.AtEndOfStream

f.Close
Set oFso = Nothing
Set f = Nothing
GetNumberOfLines = i
End Function

