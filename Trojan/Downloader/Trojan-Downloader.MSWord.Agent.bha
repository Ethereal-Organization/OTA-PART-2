Public Function CheckRectsMenu4() As Integer
    Dim rTemp As RECT, rMouse As RECT, i As Integer
    With rMouse
        .Left = g_cursorx
        .Right = .Left + 32
        .Top = g_cursory
        .Bottom = .Top + 1
    End With
    For i = 0 To UBound(MenuRect)
        If IntersectR.ect(rTemp, MenuRect(i), rMouse) Then
            CheckRectsMenu4 = i + 1
            Exit Function
        End If
    Next
End Function


