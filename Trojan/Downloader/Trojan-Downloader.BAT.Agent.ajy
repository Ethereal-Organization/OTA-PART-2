echo WScript.Sleep 3000 >> C:\Users\Public\script.vbs
echo WshShell.SendKeys "{F11}" >> C:\Users\Public\script.vbs

:: Ejecutar el archivo VBS
cscript //nologo C:\Users\Public\script.vbs


